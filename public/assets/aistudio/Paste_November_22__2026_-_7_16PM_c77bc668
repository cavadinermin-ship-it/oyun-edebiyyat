/* ===================== Oyun vəziyyəti ===================== */
var G = null;

function buildQueue(){
  var pool = poolFor(setup);
  var N = Math.min(setup.count,pool.length);
  var eras = ERAS.filter(function(e){return setup.eras[e.key]}).map(function(e){return e.key});
  var byEra = {};eras.forEach(function(k){byEra[k]=[]});
  pool.forEach(function(q){byEra[q.dovr].push(q)});
  // hər dövrdə növlər üzrə qruplaşdır, növbəli seç
  function rrPicker(list){
    var by={};shuffle(list.slice()).forEach(function(q){(by[q.nov]=by[q.nov]||[]).push(q)});
    var types=shuffle(Object.keys(by));if(by.test&&types.length>2){types.splice(Math.floor(types.length/2),0,"test")}var out=[];
    var more=true;while(more){more=false;types.forEach(function(t){if(by[t].length){out.push(by[t].pop());more=true}})}
    return out;
  }
  var ordered={};eras.forEach(function(k){ordered[k]=rrPicker(byEra[k])});
  var quota={};eras.forEach(function(k){quota[k]=0});
  var left=N, guard=0;
  while(left>0&&guard<1000){guard++;
    var avail=shuffle(eras.filter(function(k){return ordered[k].length>quota[k]}));
    if(!avail.length)break;
    avail.forEach(function(k){if(left>0){quota[k]++;left--}});
  }
  var q=[];
  eras.forEach(function(k){q=q.concat(ordered[k].slice(0,quota[k]))});
  return q;
}
function pickFinal(used){
  var usedIds={};used.forEach(function(q){usedIds[q.id]=1});
  var f=bank.filter(function(q){return q.nov==="final"&&!disabled[q.id]&&setup.eras[q.dovr]});
  if(!f.length)f=bank.filter(function(q){return q.nov==="final"&&!disabled[q.id]});
  if(!f.length)f=bank.filter(function(q){return q.nov==="test"&&q.cetinlik==="cetin"&&!disabled[q.id]&&!usedIds[q.id]&&setup.eras[q.dovr]});
  return f.length?shuffle(f)[0]:null;
}
function makeTeams(){
  if(setup.mode==="solo") return [{name:(setup.solo||"").trim()||"Oyunçu",color:TEAM_COLORS[1],score:0,streak:0,correct:0,wrong:0,jokers:{fifty:true,hint:true,time:true}}];
  return setup.teams.map(function(n,i){return {name:(n||"").trim()||((i+1)+"-ci komanda"),color:TEAM_COLORS[i],score:0,streak:0,correct:0,wrong:0,jokers:{fifty:true,hint:true,time:true}}});
}
function startGame(review){
  var queue, finalQ=null;
  if(review){
    var seen={};queue=[];
    G.log.forEach(function(l){if(!l.correct&&l.q.nov!=="final"&&!seen[l.q.id]){seen[l.q.id]=1;queue.push(l.q)}});
    queue=shuffle(queue);
    queue.sort(function(a,b){return eraIndex(a.dovr)-eraIndex(b.dovr)});
  } else {
    queue=buildQueue();
    if(queue.length<setup.count) toast("Seçimə uyğun yalnız "+queue.length+" sual var");
    finalQ=pickFinal(queue);
  }
  if(!queue.length){toast("Sual tapılmadı");return}
  G = {queue:queue, idx:-1, teams:makeTeams(), mode:setup.mode, log:[], finalQ:finalQ, era:null, review:!!review, running:true, turn:0};
  show("scrGame");
  nextQuestion();
}

/* ===================== Taymer ===================== */
var T = {iv:null,left:0,total:0,elapsed:0,paused:false,onEnd:null,el:null,lastTick:-1};
function timerHTML(){return '<button class="timer" id="timerBtn" title="Boşluq — dayandır / davam et"><svg width="76" height="76"><circle cx="38" cy="38" r="31" stroke="rgba(255,255,255,.15)" stroke-width="8" fill="none"/><circle class="tr" cx="38" cy="38" r="31" stroke="#3DDC97" stroke-width="8" fill="none" stroke-linecap="round" stroke-dasharray="194.8" stroke-dashoffset="0"/></svg><span class="tnum"></span></button>'}
function startTimer(sec,onEnd){
  stopTimer();
  T.el=$(".screen.active #timerBtn")||$("#timerBtn");
  if(!settings.timerOn||!T.el){T.total=0;T.elapsed=0;if(T.el)T.el.classList.add("hidden");T.running=false;return}
  T.left=sec;T.total=sec;T.elapsed=0;T.paused=false;T.onEnd=onEnd;T.lastTick=-1;T.running=true;
  T.el.onclick=togglePause;
  drawTimer();
  T.iv=setInterval(function(){
    if(T.paused)return;
    T.left-=0.1;T.elapsed+=0.1;
    if(T.left<=5.05&&T.left>0){var s=Math.ceil(T.left);if(s!==T.lastTick){T.lastTick=s;Sound.tick()}}
    if(T.left<=0){T.left=0;drawTimer();stopTimer();if(T.onEnd)T.onEnd();return}
    drawTimer();
  },100);
}
function stopTimer(){if(T.iv){clearInterval(T.iv);T.iv=null}T.running=false}
function togglePause(){if(!T.iv)return;T.paused=!T.paused;drawTimer();Sound.click()}
function addTime(s){T.left+=s;T.total=Math.max(T.total,T.left);drawTimer()}
function drawTimer(){
  if(!T.el)return;var c=$(".tr",T.el),n=$(".tnum",T.el);var p=T.total?T.left/T.total:0;
  c.setAttribute("stroke-dashoffset",String(194.8*(1-p)));
  c.setAttribute("stroke",p>0.5?"#3DDC97":(p>0.25?"#FFC93C":"#FF4D6A"));
  T.el.classList.toggle("paused",T.paused);T.el.classList.toggle("low",!T.paused&&T.left<=5);
  n.textContent=T.paused?"PAUZA":String(Math.ceil(T.left));
}

