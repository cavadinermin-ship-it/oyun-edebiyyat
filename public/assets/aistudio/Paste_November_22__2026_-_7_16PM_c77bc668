/* ===================== Konfetti ===================== */
function confetti(ms){
  var cv=$("#confetti");var ctx;try{ctx=cv.getContext("2d")}catch(e){return}if(!ctx)return;
  cv.width=window.innerWidth;cv.height=window.innerHeight;cv.style.display="block";
  var cols=["#FF8A00","#10C98F","#9B6BFF","#22B8F0","#FF4D7E","#FFC93C","#ffffff"];
  var P=[];for(var i=0;i<200;i++)P.push({x:Math.random()*cv.width,y:-20-Math.random()*cv.height*.6,w:6+Math.random()*8,h:8+Math.random()*10,vx:-2+Math.random()*4,vy:2+Math.random()*3.5,r:Math.random()*6,vr:-.2+Math.random()*.4,c:cols[i%cols.length]});
  var end=performance.now()+ms;
  function fr(t){
    ctx.clearRect(0,0,cv.width,cv.height);
    P.forEach(function(p){p.x+=p.vx+Math.sin(p.y/40);p.y+=p.vy;p.r+=p.vr;if(p.y>cv.height+20&&t<end-1600){p.y=-20;p.x=Math.random()*cv.width}
      ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.r);ctx.fillStyle=p.c;ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);ctx.restore()});
    if(t<end)requestAnimationFrame(fr);else{ctx.clearRect(0,0,cv.width,cv.height);cv.style.display="none"}
  }
  requestAnimationFrame(fr);
}

