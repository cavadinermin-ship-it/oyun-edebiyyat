function basePoints(q){return q.nov==="ipucu-kart"?CARD_PTS[Math.max(0,(G.cur.opened||1)-1)]:(DIFF[q.cetinlik]?DIFF[q.cetinlik].pts:200)}

function prepare(q){
  var p={q:q,hint:false,fifty:false,answered:false,opened:1};
  if(q.variantlar){p.order = q.nov==="dogru-yanlis"?[0,1]:shuffle(range(q.variantlar.length))}
  if(q.nov==="uygunlasdir"){p.right=shuffledNotIdentity(q.cutler.length);p.assign=q.cutler.map(function(){return null});p.selL=null;p.selR=null}
  if(q.nov==="zaman-lenti"||q.nov==="sujet-zenciri"){p.ord=shuffledNotIdentity(q.siralama.length);p.sel=null}
  return p;
}

function renderQuestion(){
  var q=G.queue[G.idx];var t=curTeam();
  G.cur=prepare(q);
  var ty=TYPES[q.nov];
  $("#qcard").style.setProperty("--tcol",ty.color);
  renderTop();
  var pts = q.nov==="ipucu-kart"?CARD_PTS[0]:DIFF[q.cetinlik].pts;
  $("#qhead").innerHTML =
    '<span class="badge type">'+ty.ic+' '+esc(ty.name)+'</span>'+
    '<span class="badge '+esc(q.cetinlik)+'">'+esc((DIFF[q.cetinlik]||{}).name||q.cetinlik)+'</span>'+
    '<span class="badge pts" id="ptsBadge">'+pts+' xal</span>'+
    (G.teams.length>1?'<span class="badge turn" style="--tc:'+t.color+'">Növbə: '+esc(t.name)+'</span>':'')+
    '<span class="badge prog">'+(G.idx+1)+' / '+G.queue.length+'</span>'+timerHTML();
  var qt = esc(q.sual);
  if(q.nov==="misra"&&q.misra) qt += '<span class="misra">'+esc(q.misra)+'</span>';
  $("#qtext").innerHTML=qt;
  setQIll($("#qill"),q);
  $("#qcard").classList.toggle("ill-sm",!!MULTI[q.nov]);
  $("#hintBox").innerHTML="";
  $("#qcard").classList.remove("locked");
  renderBody();
  renderJokers();
  var sec=settings.timerSec*(MULTI[q.nov]?1.5:1);
  startTimer(Math.round(sec),timeUp);
}

function renderBody(){
  var p=G.cur,q=p.q,b=$("#qbody");
  if(q.nov==="ipucu-kart"){
    var ch='<div class="cards">';
    q.ipuclari.forEach(function(c,i){
      ch+='<div class="ccard'+(i<p.opened?' open':'')+'"><div class="inner"><div class="face front"><b>'+(i+1)+'-ci ipucu</b><small>'+CARD_PTS[i]+' xal</small></div><div class="face back"><i>'+(i+1)+'-ci ipucu</i>'+esc(c)+'</div></div></div>';
    });
    ch+='</div>';
    b.innerHTML=ch+choiceHTML(q,p);
  } else if(q.variantlar){
    b.innerHTML=choiceHTML(q,p);
  } else if(q.nov==="uygunlasdir"){
    renderMatch();return;
  } else {
    renderOrder();return;
  }
  bindChoices();
}
function choiceHTML(q,p){
  var dy=q.nov==="dogru-yanlis";
  return '<div class="opts'+(dy?' dy':'')+'">'+p.order.map(function(vi,pos){
    var cls = dy?(vi===0?"dy-true":"dy-false"):("c"+pos);
    return '<button class="opt '+cls+'" data-vi="'+vi+'" data-pos="'+pos+'"><span class="k">'+(dy?(vi===0?"✓":"✗"):LETTERS[pos])+'</span><span>'+esc(q.variantlar[vi])+'</span></button>';
  }).join("")+'</div>';
}
function bindChoices(){$$("#qbody .opt").forEach(function(btn){btn.addEventListener("click",function(){chooseOption(+btn.dataset.vi)})})}
function chooseOption(vi){
  var p=G.cur;if(!p||p.answered)return;
  var btn=$('#qbody .opt[data-vi="'+vi+'"]');if(!btn||btn.classList.contains("gone"))return;
  var q=p.q;var ok = vi===q.duzgun;
  $("#qcard").classList.add("locked");
  $$("#qbody .opt").forEach(function(b){var v=+b.dataset.vi;b.classList.add(v===q.duzgun?"right":"wrong");if(v===vi)b.classList.add("chosen")});
  finish(ok,ok?1:0,'Düzgün cavab: <b>'+esc(q.variantlar[q.duzgun])+'</b>');
}

/* --- Uyğunlaşdır --- */
function renderMatch(){
  var p=G.cur,q=p.q;
  var used={};p.assign.forEach(function(r){if(r!=null)used[r]=1});
  var h='<div class="match"><div class="match-left">';
  q.cutler.forEach(function(pair,i){
    var a=p.assign[i];var cls="mrow";
    if(p.answered)cls+=(a===i?" ok":" no");
    h+='<div class="'+cls+'" data-li="'+i+'"><button class="ml'+(p.selL===i?" sel":"")+'" data-li="'+i+'">'+esc(pair[0])+'</button>'+
       '<button class="slot'+(a!=null?" filled":"")+'" data-slot="'+i+'">'+(a!=null?esc(q.cutler[a][1]):"— buraya —")+
       (p.answered&&a!==i?'<span class="fix">✔ '+esc(pair[1])+'</span>':'')+'</button></div>';
  });
  h+='</div><div class="pool"><div class="pool-title">Seçin və ya sürükləyin</div>';
  p.right.forEach(function(ri){
    h+='<button class="pchip'+(used[ri]?" used":"")+(p.selR===ri?" sel":"")+'" draggable="true" data-ri="'+ri+'">'+esc(q.cutler[ri][1])+'</button>';
  });
  h+='</div></div>';
  $("#qbody").innerHTML=h;
  if(p.answered)return;
  $$("#qbody .ml").forEach(function(b){b.addEventListener("click",function(){
    var i=+b.dataset.li;Sound.click();
    if(p.selR!=null){assignPair(i,p.selR);return}
    p.selL=(p.selL===i?null:i);renderMatch();
  })});
  $$("#qbody .slot").forEach(function(b){
    b.addEventListener("click",function(){
      var i=+b.dataset.slot;Sound.click();
      if(p.selR!=null){assignPair(i,p.selR);return}
      if(p.assign[i]!=null){p.assign[i]=null;renderMatch();updateCheckBtn();return}
      p.selL=(p.selL===i?null:i);renderMatch();
    });
    b.addEventListener("dragover",function(e){e.preventDefault();b.classList.add("over")});
    b.addEventListener("dragleave",function(){b.classList.remove("over")});
    b.addEventListener("drop",function(e){e.preventDefault();var r=e.dataTransfer.getData("text/plain");if(r!=="")assignPair(+b.dataset.slot,+r)});
  });
  $$("#qbody .pchip").forEach(function(c){
    c.addEventListener("click",function(){var r=+c.dataset.ri;Sound.click();
      if(p.selL!=null){assignPair(p.selL,r);return}
      p.selR=(p.selR===r?null:r);renderMatch();
    });
    c.addEventListener("dragstart",function(e){e.dataTransfer.setData("text/plain",c.dataset.ri)});
  });
  updateCheckBtn();
}
function assignPair(li,ri){
  var p=G.cur;
  p.assign=p.assign.map(function(v){return v===ri?null:v});
  p.assign[li]=ri;p.selL=null;p.selR=null;renderMatch();updateCheckBtn();
}
/* --- Sıralama --- */
function renderOrder(){
  var p=G.cur,q=p.q;
  var tip = q.nov==="zaman-lenti"?"Ən erkəndən ən sonraya doğru düzün.":"Hadisələri baş vermə ardıcıllığı ilə düzün.";
  var h='<div class="order-tip">'+tip+' Elementə toxunun, sonra yerini dəyişmək istədiyiniz elementə toxunun; ▲▼ düymələri də işləyir.</div><ol class="order">';
  p.ord.forEach(function(ii,pos){
    var cls="oitem";if(p.answered)cls+=(ii===pos?" ok":" no");if(p.sel===pos)cls+=" sel";
    h+='<li class="'+cls+'" draggable="'+(!p.answered)+'" data-pos="'+pos+'"><span class="num">'+(pos+1)+'</span><span class="otext" data-pos="'+pos+'">'+esc(q.siralama[ii])+'</span>'+
      (p.answered?'':'<span class="arrows"><button data-up="'+pos+'" '+(pos===0?"disabled":"")+' aria-label="Yuxarı">▲</button><button data-down="'+pos+'" '+(pos===p.ord.length-1?"disabled":"")+' aria-label="Aşağı">▼</button></span>')+'</li>';
  });
  h+='</ol>';
  $("#qbody").innerHTML=h;
  if(p.answered)return;
  function swap(a,b){var t=p.ord[a];p.ord[a]=p.ord[b];p.ord[b]=t;p.sel=null;Sound.click();renderOrder()}
  $$("#qbody .otext").forEach(function(s){s.addEventListener("click",function(){
    var pos=+s.dataset.pos;if(p.sel==null){p.sel=pos;Sound.click();renderOrder()}else if(p.sel===pos){p.sel=null;renderOrder()}else swap(p.sel,pos);
  })});
  $$("#qbody [data-up]").forEach(function(b){b.addEventListener("click",function(){var i=+b.dataset.up;swap(i,i-1)})});
  $$("#qbody [data-down]").forEach(function(b){b.addEventListener("click",function(){var i=+b.dataset.down;swap(i,i+1)})});
  var dragFrom=null;
  $$("#qbody .oitem").forEach(function(li){
    li.addEventListener("dragstart",function(e){dragFrom=+li.dataset.pos;try{e.dataTransfer.setData("text/plain",li.dataset.pos)}catch(x){}});
    li.addEventListener("dragover",function(e){e.preventDefault();li.classList.add("drag-over")});
    li.addEventListener("dragleave",function(){li.classList.remove("drag-over")});
    li.addEventListener("drop",function(e){e.preventDefault();var to=+li.dataset.pos;if(dragFrom!=null&&dragFrom!==to){var it=p.ord.splice(dragFrom,1)[0];p.ord.splice(to,0,it);Sound.click();renderOrder()}dragFrom=null});
  });
}
function checkStructured(){
  var p=G.cur;if(!p||p.answered)return;var q=p.q,n,good=0,ans;
  if(q.nov==="uygunlasdir"){
    if(p.assign.some(function(v){return v==null})){toast("Bütün cütləri tamamlayın");return}
    n=q.cutler.length;p.assign.forEach(function(v,i){if(v===i)good++});
    ans='Düzgün cütlər:<ol>'+q.cutler.map(function(c){return '<li>'+esc(c[0])+' — '+esc(c[1])+'</li>'}).join("")+'</ol>';
  } else {
    n=q.siralama.length;p.ord.forEach(function(v,i){if(v===i)good++});
    ans='Düzgün ardıcıllıq:<ol>'+q.siralama.map(function(s){return '<li>'+esc(s)+'</li>'}).join("")+'</ol>';
  }
  finish(good===n,good/n,ans,good+" / "+n+" düzgün");
  if(q.nov==="uygunlasdir")renderMatch();else renderOrder();
}

