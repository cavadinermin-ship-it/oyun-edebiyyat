    '<div class="fb-ans">'+ansHTML+'</div><div class="fb-izah">'+esc(q.izah||"")+'</div>'+
    '<div class="fb-foot"><span class="page-tag">📖 '+esc(pageText(q))+'</span><button class="next-btn" id="btnNext">'+(G.idx+1>=G.queue.length?(G.finalQ&&!G.review?"Final sualına ➜":"Nəticələr ➜"):"Növbəti ➜")+'</button></div>';
