function curTeam(){return G.teams[G.turn%G.teams.length]}
function nextQuestion(){
  hideFeedback();
  G.idx++;
  if(G.idx>=G.queue.length){
    if(G.finalQ&&!G.review){showFinal()}else{showResults()}
    return;
  }
  if(G.idx>0)G.turn++;
  var q=G.queue[G.idx];
  if(q.dovr!==G.era){G.era=q.dovr;showSplash(eraIndex(q.dovr),renderQuestion)}else renderQuestion();
}
function selectedEras(){var o={};if(G&&G.review){G.queue.forEach(function(q){o[q.dovr]=true})}else{ERAS.forEach(function(e){o[e.key]=!!setup.eras[e.key]})}return o}
