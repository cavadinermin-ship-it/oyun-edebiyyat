  h+='<button class="joker" id="jHint" '+(!t.jokers.hint||p.answered||p.hint?"disabled":"")+' title="Qısa işarə və dərslik səhifəsi; xal 50% azalır"><span class="ji" style="background:#F59E0B">💡</span>İpucu</button>';
  h+='<button class="joker" id="jTime" '+(!t.jokers.time||p.answered||!settings.timerOn?"disabled":"")+' title="Taymerə 15 saniyə əlavə olunur"><span class="ji" style="background:#10C98F">+15</span>Əlavə vaxt</button>';
  if(q.nov==="ipucu-kart") h+='<button class="action-btn" id="btnNextClue" style="background:linear-gradient(135deg,#43D9F3,#0A8FA8);color:#032a33" '+(p.opened>=4||p.answered?"disabled":"")+'>Növbəti ipucunu aç ('+(p.opened<4?CARD_PTS[p.opened]:0)+' xal)</button>';
