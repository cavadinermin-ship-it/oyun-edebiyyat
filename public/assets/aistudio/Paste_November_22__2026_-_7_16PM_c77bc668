  else if(tState.tab==="io"){
    tb.innerHTML='<p class="note">Sual bankının cari vəziyyəti (öz əlavə etdiyiniz suallar daxil) JSON faylı kimi yüklənir. Faylı başqa kompüterdə «İdxal» ilə açmaq olar.</p>'+
      '<div class="filters"><button class="big-btn" id="ioExport" style="font-size:18px;padding:12px 22px">⬇ JSON kimi ixrac et</button>'+
      '<label class="mini-btn" style="cursor:pointer">⬆ JSON faylını idxal et<input type="file" id="ioFile" accept=".json,application/json" class="hidden"></label>'+
      '<button class="mini-btn" id="ioPaste">Mətndən idxal et</button><button class="mini-btn" id="ioReset">↺ Orijinal banka qayıt</button></div>'+
      '<textarea class="json" id="ioText" placeholder="JSON mətni buraya yapışdırıla bilər..."></textarea>'+
      '<p class="note">Cari bankda <b>'+bank.length+'</b> sual var; söndürülmüş: <b>'+Object.keys(disabled).length+'</b>. İdxal edilən fayl cari bankı əvəz edir.</p>';
    $("#ioExport").onclick=exportBank;
    $("#ioFile").onchange=function(e){var f=e.target.files[0];if(!f)return;var r=new FileReader();r.onload=function(){importBank(r.result)};r.readAsText(f,"utf-8")};
    $("#ioPaste").onclick=function(){importBank($("#ioText").value)};
    $("#ioReset").onclick=function(){askConfirm("Öz əlavə etdiyiniz suallar və idxal silinsin, orijinal banka qayıdılsın?",function(){store.del("ss_bank_override");store.del("ss_custom");store.del("ss_disabled");loadBank();toast("Orijinal bank bərpa olundu");renderTeacher()})};
  } else {
    tb.innerHTML=
      '<div class="set-row"><b>Taymer</b><label class="switch"><input type="checkbox" id="sTimerOn" '+(settings.timerOn?"checked":"")+'><span></span></label><span class="note">söndürülsə, sürət bonusu verilmir</span></div>'+
      '<div class="set-row"><b>Hər suala vaxt (saniyə)</b><input type="number" id="sTimerSec" min="10" max="180" step="5" value="'+settings.timerSec+'" style="width:110px;background:#0e1238;color:#fff;border:1px solid var(--line);border-radius:10px;padding:8px"><span class="note">Uyğunlaşdır, sıralama və ipucu kartlarında vaxt 1,5 dəfə artıq olur</span></div>'+
      '<div class="set-row"><b>Standart sual sayı</b><select id="sCount" style="background:#0e1238;color:#fff;border:1px solid var(--line);border-radius:10px;padding:8px">'+[10,20,30].map(function(v){return opt(v,v,settings.count)}).join("")+'</select></div>'+
      '<div class="set-row"><b>Səs effektləri</b><label class="switch"><input type="checkbox" id="sSound" '+(settings.sound?"checked":"")+'><span></span></label></div>'+
      '<div class="set-row"><b>Xal sistemi</b><span class="note">Asan 100 · Orta 200 · Çətin 300 · «Kimdir bu sənətkar?» 400/300/200/100 · ilk 10 saniyədə düzgün cavab +50 · ardıcıl 3 düzgün +100 · İpucu jokeri xalı 50% azaldır · Uyğunlaşdır/sıralamada qismən düzgün cavaba qismən xal</span></div>';
    $("#sTimerOn").onchange=function(e){settings.timerOn=e.target.checked;saveSettings()};
    $("#sTimerSec").onchange=function(e){var v=Math.max(10,Math.min(180,parseInt(e.target.value,10)||30));settings.timerSec=v;e.target.value=v;saveSettings()};
    $("#sCount").onchange=function(e){settings.count=+e.target.value;setup.count=settings.count;saveSettings()};
    $("#sSound").onchange=function(e){settings.sound=e.target.checked;saveSettings();updateSoundBtn()};
  }
}
function filteredBank(){
  var s=tState.fText.trim().toLocaleLowerCase("az");
  return bank.filter(function(q){
    if(tState.fEra&&q.dovr!==tState.fEra)return false;
    if(tState.fType&&q.nov!==tState.fType)return false;
    if(tState.fDiff&&q.cetinlik!==tState.fDiff)return false;
    if(s){var hay=[q.sual,q.misra,q.senetkar,q.eser,q.id].join(" ").toLocaleLowerCase("az");if(hay.indexOf(s)<0)return false}
    return true;
  });
}
function drawQTable(){
  var list=filteredBank();var custom=store.get("ss_custom",[])||[];var cids={};custom.forEach(function(c){cids[c.id]=1});
  var on=bank.filter(function(q){return !disabled[q.id]}).length;
  var h='<p class="note">Göstərilir: <b>'+list.length+'</b> · Aktiv: <b>'+on+'</b> / '+bank.length+'</p><table class="qtable"><tr><th>Aktiv</th><th>ID</th><th>Növ</th><th>Dövr</th><th>Çətinlik</th><th>Sual</th><th>Səh.</th><th></th></tr>';
  list.forEach(function(q){
    h+='<tr class="'+(disabled[q.id]?"off":"")+'"><td><label class="switch"><input type="checkbox" data-tog="'+esc(q.id)+'" '+(disabled[q.id]?"":"checked")+'><span></span></label></td><td><span class="tag">'+esc(q.id)+'</span></td><td>'+esc((TYPES[q.nov]||{}).name||q.nov)+'</td><td>'+esc(q.dovr)+'</td><td>'+esc((DIFF[q.cetinlik]||{}).name||q.cetinlik)+'</td><td>'+esc(q.sual)+(q.misra?'<br><i class="note">'+esc(q.misra)+'</i>':'')+(q.senetkar||q.eser?'<br><span class="note">'+esc([q.senetkar,q.eser].filter(Boolean).join(" · "))+'</span>':'')+'</td><td>'+esc(q.sehife||"—")+'</td><td>'+(cids[q.id]?'<button class="mini-btn" data-delq="'+esc(q.id)+'" title="Sil">🗑</button>':'')+'</td></tr>';
  });
  $("#qtWrap").innerHTML=h+'</table>';
  $$("#qtWrap [data-tog]").forEach(function(c){c.addEventListener("change",function(){var id=c.getAttribute("data-tog");if(c.checked)delete disabled[id];else disabled[id]=1;store.set("ss_disabled",Object.keys(disabled));c.closest("tr").classList.toggle("off",!c.checked)})});
  $$("#qtWrap [data-delq]").forEach(function(b){b.addEventListener("click",function(){
    var id=b.getAttribute("data-delq");askConfirm("Bu sual silinsin?",function(){
    var c=(store.get("ss_custom",[])||[]).filter(function(x){return x.id!==id});store.set("ss_custom",c);
    bank=bank.filter(function(x){return x.id!==id});
    var ov=store.get("ss_bank_override",null);if(Array.isArray(ov))store.set("ss_bank_override",ov.filter(function(x){return x.id!==id}));
    drawQTable();
  })})});
}
function renderAddForm(){
  var t=tState.addType;
  var h='<div class="form">'+
    '<label>Növ<select id="aType">'+Object.keys(TYPES).map(function(k){return opt(k,TYPES[k].name,t)}).join("")+'</select></label>'+
    '<label>Dövr<select id="aEra">'+ERAS.map(function(e){return opt(e.key,e.key,"")}).join("")+'</select></label>'+
    '<label>İstiqamət<select id="aDir">'+opt("Əsərlər","Əsərlər","")+opt("Sənətkarlar","Sənətkarlar","")+'</select></label>'+
    '<label>Çətinlik<select id="aDiff">'+opt("asan","Asan","")+opt("orta","Orta","orta")+opt("cetin","Çətin","")+'</select></label>'+
    '<label>Sənətkar (istəyə görə)<input id="aSen"></label><label>Əsər (istəyə görə)<input id="aEser"></label>'+
    '<label class="full">'+(t==="ipucu-kart"?"Sual mətni (məs.: Kimdir bu sənətkar?)":"Sual mətni")+'<textarea id="aSual">'+(t==="ipucu-kart"?"Kimdir bu sənətkar?":"")+'</textarea></label>';
  if(t==="misra") h+='<label class="full">Misra(lar)<textarea id="aMisra"></textarea></label>';
  if(t==="ipucu-kart") h+='<label class="full">4 ipucu (hər sətirdə bir; çətindən asana)<textarea id="aClues"></textarea></label>';
  if(t==="test"||t==="misra"||t==="final"||t==="ipucu-kart"){
    h+='<div class="full"><div class="note" style="margin-bottom:6px">Variantlar (düzgün olanı işarələyin)</div><div class="var-grid">'+
      LETTERS.map(function(L,i){return '<label><input type="radio" name="aOk" value="'+i+'" '+(i===0?"checked":"")+'> '+L+' <input type="text" class="aVar" data-i="'+i+'"></label>'}).join("")+'</div></div>';
  }
  if(t==="dogru-yanlis") h+='<div class="full"><label style="flex-direction:row;gap:14px"><span><input type="radio" name="aDY" value="0" checked> Doğru</span><span><input type="radio" name="aDY" value="1"> Yanlış</span></label></div>';
  if(t==="uygunlasdir") h+='<label class="full">4–5 cüt (hər sətirdə: sol | sağ)<textarea id="aPairs" placeholder="Səadət xanım | «Müsibəti-Fəxrəddin»"></textarea></label>';
  if(t==="zaman-lenti"||t==="sujet-zenciri") h+='<label class="full">4–5 element DÜZGÜN ardıcıllıqla (hər sətirdə bir)<textarea id="aItems"></textarea></label>';
  h+='<label class="full">İzah (1–2 cümlə)<textarea id="aIzah"></textarea></label><label>Dərslik səhifəsi<input id="aPage" placeholder="məs.: 80 və ya 81–83"></label>'+
    '<div style="display:flex;align-items:flex-end"><button class="big-btn" id="aSave" style="font-size:19px;padding:12px 24px">＋ Sualı əlavə et</button></div></div>';
  $("#tBody").innerHTML=h;
  $("#aType").onchange=function(e){tState.addType=e.target.value;renderAddForm()};
  $("#aSave").onclick=saveNewQuestion;
}
function lines(id){var el=$("#"+id);return el?el.value.split("\n").map(function(s){return s.trim()}).filter(Boolean):[]}
function saveNewQuestion(){
  var t=tState.addType;var sual=$("#aSual").value.trim();
  if(!sual){toast("Sual mətnini yazın");return}
  var q={id:"custom-"+Date.now(),dovr:$("#aEra").value,istiqamet:$("#aDir").value,senetkar:$("#aSen").value.trim()||null,eser:$("#aEser").value.trim()||null,
    nov:t,cetinlik:$("#aDiff").value,sual:sual,izah:$("#aIzah").value.trim(),sehife:$("#aPage").value.trim()||null};
  if(t==="test"||t==="misra"||t==="final"||t==="ipucu-kart"){
    var v=$$(".aVar").map(function(i){return i.value.trim()});
    if(v.some(function(x){return !x})){toast("4 variantın hamısını yazın");return}
    q.variantlar=v;q.duzgun=+($('input[name="aOk"]:checked')||{value:0}).value;
  }
  if(t==="misra"){q.misra=$("#aMisra").value.trim();if(!q.misra){toast("Misranı yazın");return}}
  if(t==="ipucu-kart"){q.ipuclari=lines("aClues");if(q.ipuclari.length!==4){toast("Düz 4 ipucu yazın");return}}
  if(t==="dogru-yanlis"){q.variantlar=["Doğru","Yanlış"];q.duzgun=+($('input[name="aDY"]:checked')||{value:0}).value}
  if(t==="uygunlasdir"){
    q.cutler=lines("aPairs").map(function(l){var p=l.split("|");return [String(p[0]||"").trim(),String(p.slice(1).join("|")).trim()]}).filter(function(p){return p[0]&&p[1]});
    if(q.cutler.length<4||q.cutler.length>5){toast("4–5 düzgün cüt yazın (sol | sağ)");return}
    var rs={};if(q.cutler.some(function(p){if(rs[p[1]])return true;rs[p[1]]=1;return false})){toast("Sağ tərəfdəki dəyərlər təkrarlanmamalıdır");return}
  }
  if(t==="zaman-lenti"||t==="sujet-zenciri"){q.siralama=lines("aItems");if(q.siralama.length<4||q.siralama.length>5){toast("4–5 element yazın");return}}
  var c=store.get("ss_custom",[])||[];c.push(q);store.set("ss_custom",c);
  bank.push(q);
  toast("Sual əlavə olundu: "+q.id);Sound.correct();
  renderAddForm();
}
function exportBank(){
  var data=JSON.stringify(bank,null,1);
  $("#ioText").value=data;
  try{var blob=new Blob([data],{type:"application/json"});var a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="soz-senetimiz-sual-banki.json";document.body.appendChild(a);a.click();setTimeout(function(){URL.revokeObjectURL(a.href);a.remove()},500);toast("Fayl yükləndi")}
  catch(e){toast("Yükləmə alınmadı — mətni aşağıdan kopyalayın")}
}
function importBank(text){
  var arr;try{arr=JSON.parse(text)}catch(e){toast("JSON oxunmadı: formatı yoxlayın");return}
  if(!Array.isArray(arr)||!arr.length){toast("Fayl sual massivi olmalıdır");return}
  var bad=arr.filter(function(q){return !q||!q.id||!q.nov||!q.sual||!TYPES[q.nov]});
  if(bad.length){toast(bad.length+" sualda id / nov / sual sahəsi yoxdur");return}
  store.set("ss_bank_override",arr);store.set("ss_custom",[]);
  loadBank();bank=arr.slice();
  toast(arr.length+" sual idxal olundu");renderTeacher();
}

/* ===================== Başlat ===================== */
renderStart();
})();
</script>
