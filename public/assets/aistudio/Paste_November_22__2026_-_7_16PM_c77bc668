function finish(ok,frac,ansHTML,partLabel,timeout){
  var p=G.cur,q=p.q,t=curTeam();
  p.answered=true;var elapsed=T.elapsed;stopTimer();
  var base=basePoints(q),pts=0,parts=[];
  if(ok){
    pts=base;parts.push(base+" əsas xal");
    if(p.hint){pts=Math.round(pts/2);parts.push("ipucu: ×0,5")}
    if(settings.timerOn&&elapsed<=10){pts+=50;parts.push("+50 sürət bonusu")}
    t.streak++;if(t.streak%3===0){pts+=100;parts.push("+100 seriya bonusu")}
    t.correct++;Sound.correct();
  } else {
    if(frac>0&&!timeout){pts=Math.round(base*frac/10)*10;if(p.hint)pts=Math.round(pts/2);if(pts>0)parts.push("qismən düzgün: "+partLabel)}
    t.streak=0;t.wrong++;Sound.wrong();
