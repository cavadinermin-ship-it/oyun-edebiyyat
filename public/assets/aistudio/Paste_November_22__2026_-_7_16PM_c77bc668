</header>

<main>
  <!-- ============ BAŞLANĞIC ============ -->
  <section id="scrStart" class="screen active">
    <div class="hero">
      <h1>Söz sənətimizin izi ilə</h1>
      <p>X sinif ədəbiyyatı üzrə interaktiv yarış: «Dədə Qorqud»dan «Müsibəti-Fəxrəddin»ə qədər</p>
      <div class="src">Mənbə: «Ədəbiyyat – 10» (S.Əliyev, B.Həsənov, A.Mustafayeva)</div>
      <div class="ill-ribbon" id="heroRibbon"></div>
    </div>
    <div class="start-grid">
      <div class="panel">
        <h3><i style="background:var(--e1)">1</i>Rejim</h3>
        <div class="mode-cards">
          <button class="mode-card" data-mode="team"><span class="ico">👥</span><b>Komanda yarışı</b><small>2–4 komanda, sinifdə lövhədə</small></button>
          <button class="mode-card" data-mode="solo"><span class="ico">🎯</span><b>Fərdi məşq</b><small>Evdə telefon və ya kompüterdə</small></button>
        </div>
        <div id="teamsBox" class="teams"></div>
        <div id="soloBox" class="solo-name hidden" style="margin-top:14px;display:flex;gap:10px"><input id="soloName" maxlength="30" placeholder="Adınız (diplom üçün)"></div>
      </div>
      <div class="panel">
        <h3><i style="background:var(--e2)">2</i>İstiqamət</h3>
        <div class="seg" id="dirSeg"></div>
        <h3 style="margin-top:20px"><i style="background:var(--e4)">3</i>Çətinlik</h3>
        <div class="seg" id="diffSeg"></div>
        <h3 style="margin-top:20px"><i style="background:var(--e5)">4</i>Sual sayı</h3>
        <div class="seg" id="countSeg"></div>
      </div>
      <div class="panel span2">
        <h3><i style="background:var(--e3)">5</i>Ədəbi xəritə — dövrləri seçin (bir neçəsini birlikdə seçmək olar)</h3>
        <div class="map-wrap" id="startMap"></div>
      </div>
    </div>
    <div class="start-foot">
      <div class="pool-info" id="poolInfo"></div>
      <button class="big-btn" id="btnStart">Yola çıx ➜</button>
    </div>
    <div class="kbd-help">Qısayollar: <kbd>1</kbd>–<kbd>4</kbd> variant seçimi · <kbd>Enter</kbd> növbəti · <kbd>Boşluq</kbd> taymeri dayandırır</div>
  </section>

  <!-- ============ OYUN ============ -->
  <section id="scrGame" class="screen">
    <div class="game-top">
      <div class="map-wrap" id="gameMap"></div>
      <div class="scoreboard" id="scoreboard"></div>
    </div>
    <div class="qcard" id="qcard">
      <div class="qhead" id="qhead"></div>
      <div class="qrow"><div class="qtext" id="qtext"></div><figure class="qill" id="qill"></figure></div>
      <div id="qbody"></div>
      <div id="hintBox"></div>
      <div class="jokers" id="jokers"></div>
    </div>
  </section>

  <!-- ============ FİNAL ============ -->
  <section id="scrFinal" class="screen">
    <div class="final-hero"><h2>★ Final sualı ★</h2><p id="finalSub"></p></div>
    <div id="finalBody"></div>
  </section>

  <!-- ============ YEKUN ============ -->
  <section id="scrResults" class="screen">
    <div class="final-hero"><h2 id="resTitle">Yekun nəticələr</h2><p id="resSub"></p></div>
    <div class="podium" id="podium"></div>
    <div class="res-grid">
      <div class="panel"><h3>Komandalar üzrə statistika</h3><div id="resTable"></div></div>
      <div class="panel"><h3>Ümumi göstəricilər</h3><div class="kpis" id="resKpis"></div></div>
    </div>
    <div class="ill-ribbon" id="resRibbon"></div>
    <div class="res-actions">
      <button class="big-btn" id="btnReview">Səhvlərimi təkrar et</button>
      <button class="ghost-btn" id="btnPrint">🖨 Diplomu çap et</button>
      <button class="ghost-btn" id="btnAgain">↻ Yeni oyun</button>
    </div>
  </section>
</main>

